# Copy this file to .env.local for local development, and add the same two
# names under Vercel > Project > Settings > Environment Variables.
# Never put a "service_role" or "secret" key in here. Only the publishable key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
